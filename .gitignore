# ---------------------------------------------------------------
# Third-party assets (see README > Third-party assets)
# These can't be redistributed, so they stay out of the repo.
# ---------------------------------------------------------------

# Whole asset packs: importing them restores their own .meta files
/Assets/SeyeonjeongPavilion/
/Assets/SeyeonjeongPavilion.meta
/Assets/Submission/
/Assets/Submission.meta

# Single downloaded files. Their .meta files ARE committed so the
# scene keeps its references when the original files are dropped back in.
/Assets/Sounds/*.mp3
/Assets/Materials/uploads_files_4742161_rake.fbx
/Assets/Materials/0016-beach-sand-texture-seamless.jpg

# Unused / unknown origin, not needed to run the project
/Assets/Materials/sand-surface-texture-beige-background-zen-peace-concept.jpg
/Assets/Materials/sand-surface-texture-beige-background-zen-peace-concept.jpg.meta
/Assets/Prefabs/rake_cat.fbx
/Assets/Prefabs/rake_cat.fbx.meta

